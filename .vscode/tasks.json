{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "MinGW Makefiles"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Configures the project with CMake using MinGW Makefiles."
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": [
        "CMake: configure"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds the configured CMake project."
    },
    {
      "label": "CMake: run",
      "type": "shell",
      "command": "${workspaceFolder}/build/AtomicFitSolver.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake: build"
      ],
      "problemMatcher": [],
      "group": "test",
      "detail": "Runs the built project executable."
    }
  ]
}